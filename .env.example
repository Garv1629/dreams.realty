# Next.js Application Environment Variables
# Do not commit the actual .env file to version control.

# API Base URLs (if connecting to the existing Dreams Realty backend)
NEXT_PUBLIC_API_URL=https://backend.dreamsrealty.co.in/api

# Analytics & Tracking (Google Analytics)
# Set this to enable tracking on production
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Contact / CRM Integration endpoints
NEXT_PUBLIC_CRM_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
