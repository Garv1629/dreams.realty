{
  "name": "dreams-realty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node run_dev.js",
    "build": "next build",
    "start": "node serve.js",
    "lint": "next lint",
    "clean": "node -e \"const fs=require('fs');const p=require('path');function r(d){if(fs.existsSync(d)){fs.readdirSync(d).forEach(f=>{const fp=p.join(d,f);fs.lstatSync(fp).isDirectory()?r(fp):fs.unlinkSync(fp)});fs.rmdirSync(d)}};r('.next');\""
  },
  "dependencies": {
    "@react-three/drei": "^9.105.4",
    "@react-three/fiber": "^8.16.1",
    "framer-motion": "^11.0.25",
    "gsap": "^3.12.5",
    "lenis": "^1.1.18",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18",
    "three": "^0.163.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.163.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "autoprefixer": "^10.4.19",
    "typescript": "^5"
  }
}
